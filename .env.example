# Public URL of the app — required by SvelteKit in production (CSRF protection)
ORIGIN=https://calirko.com

# Admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
# Secret used to sign session cookies — change this to a long random string
ADMIN_SECRET=change-me-in-production

# Name of the external Docker network Dokploy manages
TRAEFIK_NETWORK=dokploy-network

# Path to the JSON database file (mapped to the db-data volume in compose)
DATABASE_PATH=./data/db.json

# MinIO connection
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=calirko-bin

# Optional: override the public URL used to build file links (e.g. CDN)
# MINIO_PUBLIC_URL=https://files.calirko.com

# Max request body size for file uploads in bytes (default 10 MB)
# BODY_SIZE_LIMIT=10485760
