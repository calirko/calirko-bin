# Public URL of the app
ORIGIN=https://calirko.com

# Admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
# Secret used to sign session cookies — use a long random string
ADMIN_SECRET=change-me-in-production

# MinIO — point at your existing instance on the dragon network
MINIO_ENDPOINT=minio          # container name or hostname on the dragon network
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=your-access-key
MINIO_SECRET_KEY=your-secret-key
MINIO_BUCKET=calirko-bin
# Public URL browsers use to load uploaded files (route via Cloudflare tunnel)
MINIO_PUBLIC_URL=https://files.calirko.com

# Cloudflare Tunnel token — Zero Trust dashboard → Networks → Tunnels → your tunnel → token
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token

# Optional: raise the upload body limit (bytes, default 10 MB)
# BODY_SIZE_LIMIT=10485760
